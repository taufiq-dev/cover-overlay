{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@cover-overlay": ["../components/cover-overlay"],
      "@cover-overlay/*": ["../components/cover-overlay/*"],
      // ../components has no node_modules; point its bare imports at this app's.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "styled-components": ["./node_modules/styled-components"]
    }
  },
  "include": ["src", "../components"]
}
